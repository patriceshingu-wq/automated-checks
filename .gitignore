# =========================================================
# .gitignore for AI / ML projects
# Transformed 2 Succeed
# =========================================================

# ---------- Secrets and credentials (never commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json
*-credentials.json
.aws/
.azure/
.gcloud/
.huggingface/
.netrc

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
.conda/
.python-version
.pdm.toml
.pdm-python
__pypackages__/

# ---------- Testing, linting and type checking ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/

# ---------- Jupyter notebooks ----------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------- Data (keep folders, ignore contents) ----------
data/*
!data/.gitkeep
!data/README.md
datasets/
raw/
processed/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.gz

# ---------- Models and checkpoints ----------
models/*
!models/.gitkeep
!models/README.md
checkpoints/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
*.pickle
*.joblib
*.h5model
*.keras
*.tflite
*.pb
*.gguf
*.ggml

# ---------- Hugging Face and model caches ----------
.cache/
hf_cache/
transformers_cache/
torch_cache/
.ollama/

# ---------- Experiment tracking ----------
mlruns/
mlartifacts/
wandb/
.neptune/
lightning_logs/
runs/
outputs/
multirun/
logs/
*.log
tensorboard/
events.out.tfevents.*

# ---------- Data and model versioning (DVC) ----------
# Track the .dvc files in Git; ignore the cache.
.dvc/cache/
.dvc/tmp/

# ---------- Vector databases and RAG indexes ----------
chroma/
chroma_db/
.chroma/
qdrant_storage/
faiss_index/
*.faiss
*.index
lancedb/
vectorstore/

# ---------- LLM app artifacts ----------
.langchain.db
prompts_cache/
llm_cache/
*.sqlite
*.sqlite3
*.db

# ---------- Docker and infrastructure ----------
docker-compose.override.yml
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log

# ---------- Node (for AI web apps) ----------
node_modules/
.next/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editors and IDEs ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---------- Operating system files ----------
.DS_Store
Thumbs.db
desktop.ini